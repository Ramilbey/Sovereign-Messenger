.mx_Welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(180deg, rgba(10, 22, 40, 0.95) 0%, rgba(15, 29, 58, 0.98) 100%);
    box-sizing: border-box;
    padding: 48px 40px 32px;
    min-width: 420px;

    &.mx_WelcomePage_registrationDisabled {
        .mx_ButtonCreateAccount {
            display: none;
        }
    }
}

.mx_Welcome .mx_AuthBody_language {
    width: 160px;
    margin: var(--cpd-space-1x) 0;
}

/* Do NOT invert the government seal in dark mode */
.cpd-theme-dark .mx_WelcomePage_logo {
    filter: none;
}
