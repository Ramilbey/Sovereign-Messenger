/*
 * SOVEREIGN MESSENGER — Telegram Web Dark Theme
 * Exact Telegram Web Z/K colors & layout
 */

/* ── FONTS ──────────────────────────────────────────────────────────────── */
* { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }

/* ── TELEGRAM COLOR VARIABLES ───────────────────────────────────────────── */
:root {
    --tg-sidebar:       #17212b;
    --tg-canvas:        #0e1621;
    --tg-hover:         #202b36;
    --tg-active:        #2b5278;
    --tg-border:        #0a0f18;
    --tg-bubble-in:     #182533;
    --tg-bubble-out:    #2b5278;
    --tg-accent:        #5288c1;
    --tg-accent-light:  #40a7e3;
    --tg-text:          #ffffff;
    --tg-text2:         #7f91a4;
    --tg-text3:         #56687a;

    /* Override Element/Compound variables */
    --accent:                          #5288c1 !important;
    --accent-color:                    #5288c1 !important;
    --background:                      #0e1621 !important;
    --primary-content:                 #ffffff !important;
    --secondary-content:               #7f91a4 !important;
    --roomlist-background-color:       #17212b !important;
    --timeline-background-color:       #0e1621 !important;
    --sidebar-color:                   #17212b !important;
    --header-panel-bg-color:           #17212b !important;
    --header-panel-text-primary-color: #ffffff !important;
    --header-panel-text-secondary-color: #7f91a4 !important;
    --muted-fg-color:                  #7f91a4 !important;
    --input-darker-bg-color:           #0e1621 !important;
    --input-border-color:              #242f3d !important;
    --input-focused-border-color:      #5288c1 !important;
    --menu-bg-color:                   #17212b !important;
    --menu-border-color:               #242f3d !important;
    --dialog-background-bg-color:      #17212b !important;
    --cpd-color-bg-canvas-default:     #0e1621 !important;
    --cpd-color-bg-subtle-primary:     #17212b !important;
    --cpd-color-bg-subtle-secondary:   #202b36 !important;
    --cpd-color-text-primary:          #ffffff !important;
    --cpd-color-text-secondary:        #7f91a4 !important;
    --cpd-color-bg-action-primary-rest: #5288c1 !important;
    --cpd-color-bg-action-primary-hovered: #40a7e3 !important;
    --cpd-color-icon-primary:          #ffffff !important;
    --cpd-color-icon-secondary:        #7f91a4 !important;
    --cpd-color-icon-accent:           #5288c1 !important;
    --cpd-color-text-action-accent:    #5288c1 !important;
    --cpd-color-border-subtle:         #101721 !important;
}

/* ── BASE LAYOUT ────────────────────────────────────────────────────────── */
html, body, #matrixchat,
.mx_MatrixChat, .mx_MatrixChat_wrapper,
.mx_MainSplit {
    background: var(--tg-canvas) !important;
    color: var(--tg-text) !important;
}

/* ── SPACE PANEL (Far Left Icon Strip) ─────────────────────────────────── */
.mx_SpacePanel {
    background: #0d1823 !important;
    border-right: 1px solid var(--tg-border) !important;
}

.mx_SpaceButton:hover { background: rgba(255,255,255,0.07) !important; border-radius: 14px !important; }
.mx_SpaceButton_selected { background: var(--tg-active) !important; border-radius: 14px !important; }
.mx_SpaceButton_hasAvatar .mx_BaseAvatar { border-radius: 50% !important; }

/* ── LEFT PANEL (Chat List Sidebar) ────────────────────────────────────── */
.mx_LeftPanel, .mx_LeftPanel2,
[class*="LeftPanel"],
.mx_LeftPanel_wrapper {
    background: var(--tg-sidebar) !important;
    border-right: 1px solid var(--tg-border) !important;
}

/* ── SEARCH BOX ─────────────────────────────────────────────────────────── */
.mx_RoomSearch, .mx_SearchBox,
.mx_LeftPanel .mx_SearchBox,
.mx_LeftPanel_search {
    background: var(--tg-sidebar) !important;
    padding: 10px 12px !important;
}

.mx_SearchBox .mx_SearchBox_search,
.mx_RoomSearch .mx_SearchBox_search,
input.mx_SearchBox_search,
.mx_RoomSearch_input {
    background: #242f3d !important;
    border: 1px solid transparent !important;
    border-radius: 22px !important;
    color: #fff !important;
    padding: 8px 14px 8px 38px !important;
    font-size: 14px !important;
    caret-color: var(--tg-accent) !important;
}

.mx_SearchBox .mx_SearchBox_search:focus,
.mx_RoomSearch_input:focus {
    border-color: var(--tg-accent) !important;
    background: #1a2535 !important;
}

/* ── ROOM LIST SECTION HEADERS ──────────────────────────────────────────── */
.mx_RoomSublist_headerText,
.mx_RoomSublist h4 {
    color: var(--tg-text2) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    padding: 8px 20px 4px !important;
}

/* ── ROOM TILE (Chat List Item) ─────────────────────────────────────────── */
.mx_RoomTile, [class*="RoomTile"] {
    height: 68px !important;
    margin: 1px 6px !important;
    border-radius: 12px !important;
    padding: 8px 12px !important;
    background: transparent !important;
    transition: background 0.12s ease !important;
    align-items: center !important;
}

.mx_RoomTile:hover { background: var(--tg-hover) !important; }
.mx_RoomTile_selected,
.mx_RoomTile[aria-selected="true"],
.mx_RoomTile.mx_RoomTile_selected { background: var(--tg-active) !important; }

/* Room Tile Name */
.mx_RoomTile_nameContainer .mx_RoomTile_name,
.mx_RoomTile_name {
    color: #fff !important;
    font-size: 15px !important;
    font-weight: 600 !important;
}

/* Room Tile Preview */
.mx_RoomTile_subtitle, .mx_RoomTile_messagePreview,
[class*="RoomTile_messagePreview"] {
    color: var(--tg-text2) !important;
    font-size: 13.5px !important;
}

/* Timestamp on Room Tile */
.mx_RoomTile_timestamp { color: var(--tg-text3) !important; font-size: 12px !important; }

/* ── UNREAD BADGE ───────────────────────────────────────────────────────── */
.mx_NotificationBadge, .mx_NotificationBadge_count,
[class*="NotificationBadge"] {
    background: var(--tg-accent-light) !important;
    color: #fff !important;
    border-radius: 12px !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    padding: 1px 6px !important;
    min-width: 20px !important;
    height: 20px !important;
}

.mx_NotificationBadge_highlighted { background: #e53935 !important; }

/* ── AVATARS (All Circular) ─────────────────────────────────────────────── */
.mx_BaseAvatar, .mx_BaseAvatar_image,
img[class*="Avatar"],
[class*="MemberAvatar"] img,
[class*="RoomAvatar"] img,
.mx_UserTile_avatar, .mx_EntityTile_avatar {
    border-radius: 50% !important;
    object-fit: cover !important;
}

/* ── ROOM HEADER (Top Bar) ──────────────────────────────────────────────── */
.mx_LegacyRoomHeader, .mx_RoomHeader,
[class*="RoomHeader"] {
    background: var(--tg-sidebar) !important;
    border-bottom: 1px solid var(--tg-border) !important;
    height: 56px !important;
    min-height: 56px !important;
    padding: 0 16px !important;
}

.mx_LegacyRoomHeader_name, .mx_RoomHeader_nametext,
[class*="RoomHeader_title"], [class*="RoomHeader_name"] {
    color: #fff !important;
    font-weight: 700 !important;
    font-size: 16px !important;
}

.mx_LegacyRoomHeader_topic, .mx_RoomHeader_topic,
[class*="RoomHeader_subtitle"] {
    color: var(--tg-text2) !important;
    font-size: 13px !important;
}

/* Header Icon Buttons */
.mx_LegacyRoomHeader .mx_AccessibleButton,
.mx_RoomHeader .mx_AccessibleButton {
    color: var(--tg-text2) !important;
    border-radius: 50% !important;
    width: 36px !important; height: 36px !important;
    transition: background 0.15s, color 0.15s !important;
}

.mx_LegacyRoomHeader .mx_AccessibleButton:hover,
.mx_RoomHeader .mx_AccessibleButton:hover {
    background: rgba(255,255,255,0.08) !important;
    color: #fff !important;
}

/* ── CHAT TIMELINE / CANVAS ─────────────────────────────────────────────── */
.mx_RoomView_body,
.mx_RoomView, [class*="RoomView"],
.mx_ScrollPanel .mx_RoomView_MessageList {
    background: var(--tg-canvas) !important;
}

.mx_RoomView_MessageList, .mx_TimelinePanel .mx_ScrollPanel {
    background: var(--tg-canvas) !important;
    padding: 8px 0 !important;
}

/* ── TELEGRAM MESSAGE BUBBLES ───────────────────────────────────────────── */
.mx_EventTile {
    padding: 2px 16px !important;
}

/* Generic tile line container */
.mx_EventTile .mx_EventTile_line,
.mx_EventTile_continuation .mx_EventTile_line {
    background: var(--tg-bubble-in) !important;
    border-radius: 14px 14px 14px 4px !important;
    padding: 8px 12px 8px 12px !important;
    max-width: 65% !important;
    width: fit-content !important;
    box-shadow: 0 1px 2px rgba(0,0,0,.35) !important;
    margin-right: auto !important;
    color: #fff !important;
    border: none !important;
}

/* OWN messages (sent by self) */
.mx_EventTile_own .mx_EventTile_line {
    background: var(--tg-bubble-out) !important;
    border-radius: 14px 14px 4px 14px !important;
    margin-left: auto !important;
    margin-right: 0 !important;
}

/* Body text */
.mx_EventTile_body, .mx_EventTile_content,
.mx_MTextBody, .mx_IBody {
    color: #fff !important;
    font-size: 14.5px !important;
    line-height: 1.5 !important;
}

/* Sender display name (in group rooms) */
.mx_EventTile .mx_SenderProfile .mx_SenderProfile_name,
.mx_EventTile_senderDetails .mx_SenderProfile,
[class*="EventTile_sender"] {
    color: var(--tg-accent-light) !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
}

/* Timestamp */
.mx_MessageTimestamp {
    color: rgba(255,255,255,0.45) !important;
    font-size: 11px !important;
    margin-left: 8px !important;
}

.mx_EventTile_own .mx_MessageTimestamp {
    color: rgba(255,255,255,0.55) !important;
}

/* Read receipts (Telegram double-tick style) */
.mx_ReadReceiptGroup { margin-right: 4px !important; }

/* System events (join, leave) */
.mx_EventTile_info .mx_EventTile_line {
    background: transparent !important;
    box-shadow: none !important;
    color: var(--tg-text2) !important;
    font-size: 13px !important;
    text-align: center !important;
    margin: 0 auto !important;
    max-width: 100% !important;
}

/* ── TELEGRAM DATE SEPARATOR ────────────────────────────────────────────── */
.mx_DateSeparator, .mx_TimelineSeparator {
    color: var(--tg-text2) !important;
    font-size: 12.5px !important;
    font-weight: 500 !important;
    text-align: center !important;
}

.mx_DateSeparator hr { border-color: rgba(255,255,255,0.06) !important; }

/* ── MESSAGE COMPOSER BAR ───────────────────────────────────────────────── */
.mx_MessageComposer, [class*="MessageComposer"],
.mx_MessageComposer_wrapper {
    background: var(--tg-sidebar) !important;
    border-top: 1px solid var(--tg-border) !important;
    padding: 10px 16px !important;
}

/* Pill input */
.mx_BasicMessageComposer, [class*="BasicMessageComposer"],
.mx_MessageComposer_input {
    background: #1a2635 !important;
    border: 1.5px solid transparent !important;
    border-radius: 22px !important;
    color: #fff !important;
    padding: 8px 18px !important;
    font-size: 15px !important;
    min-height: 42px !important;
    caret-color: var(--tg-accent) !important;
}

.mx_BasicMessageComposer:focus-within,
.mx_BasicMessageComposer_focused {
    border-color: var(--tg-accent) !important;
}

/* Send button round */
.mx_MessageComposer_sendMessage,
button[class*="SendButton"],
button[aria-label*="Send"] {
    background: var(--tg-accent) !important;
    border-radius: 50% !important;
    width: 42px !important;
    height: 42px !important;
    min-width: 42px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 2px 10px rgba(82,136,193,.5) !important;
    border: none !important;
    transition: all 0.15s ease !important;
    cursor: pointer !important;
}

.mx_MessageComposer_sendMessage:hover {
    background: var(--tg-accent-light) !important;
    transform: scale(1.07) !important;
}

/* Toolbar icons inside composer */
.mx_MessageComposer_actions .mx_AccessibleButton {
    color: var(--tg-text2) !important;
    border-radius: 50% !important;
    width: 36px !important; height: 36px !important;
    transition: all 0.15s ease !important;
}

.mx_MessageComposer_actions .mx_AccessibleButton:hover {
    color: var(--tg-accent) !important;
    background: rgba(82,136,193,0.12) !important;
}

/* ── RIGHT PANEL ────────────────────────────────────────────────────────── */
.mx_RightPanel, [class*="RightPanel"] {
    background: var(--tg-sidebar) !important;
    border-left: 1px solid var(--tg-border) !important;
}

/* ── SETTINGS / DIALOGS / MODALS ────────────────────────────────────────── */
.mx_Dialog_wrapper .mx_Dialog,
.mx_Dialog {
    background: #1c2733 !important;
    border-radius: 16px !important;
    border: 1px solid #2a3645 !important;
    box-shadow: 0 20px 60px rgba(0,0,0,.7) !important;
    color: #fff !important;
}

.mx_Dialog h2, .mx_Dialog h3 {
    color: #fff !important;
    font-weight: 600 !important;
}

.mx_Dialog_title {
    color: #fff !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    border-bottom: 1px solid #2a3645 !important;
    padding-bottom: 12px !important;
}

/* ── CONTEXT MENU ───────────────────────────────────────────────────────── */
.mx_ContextualMenu {
    background: #1c2733 !important;
    border: 1px solid #2a3645 !important;
    border-radius: 12px !important;
    box-shadow: 0 10px 30px rgba(0,0,0,.6) !important;
    padding: 6px !important;
}

.mx_ContextualMenu_item, .mx_CallContextMenu_item,
.mx_ContextualMenu .mx_AccessibleButton {
    color: #fff !important;
    border-radius: 8px !important;
    padding: 10px 14px !important;
    font-size: 14px !important;
    transition: background 0.1s !important;
}

.mx_ContextualMenu .mx_AccessibleButton:hover {
    background: var(--tg-hover) !important;
    color: var(--tg-accent-light) !important;
}

/* ── SETTINGS PANEL ─────────────────────────────────────────────────────── */
.mx_UserSettingsDialog, .mx_TabbedView,
.mx_UserSettings {
    background: #1c2733 !important;
    color: #fff !important;
}

.mx_TabbedView_tabLabel {
    color: var(--tg-text2) !important;
    border-radius: 10px !important;
    transition: all 0.15s !important;
}

.mx_TabbedView_tabLabel:hover { background: var(--tg-hover) !important; color: #fff !important; }
.mx_TabbedView_tabLabel_active { background: var(--tg-active) !important; color: #fff !important; }

/* Settings Fields */
.mx_Field input, .mx_Field select, .mx_Field textarea {
    background: #0e1621 !important;
    border: 1.5px solid #2a3645 !important;
    border-radius: 10px !important;
    color: #fff !important;
    padding: 10px 14px !important;
}

.mx_Field input:focus, .mx_Field select:focus {
    border-color: var(--tg-accent) !important;
    box-shadow: 0 0 0 2px rgba(82,136,193,0.2) !important;
}

/* ── BUTTONS (Primary/Secondary) ────────────────────────────────────────── */
.mx_AccessibleButton_kind_primary,
.mx_Dialog_primary {
    background: var(--tg-accent) !important;
    color: #fff !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
    border: none !important;
    padding: 10px 22px !important;
    transition: all 0.15s ease !important;
}

.mx_AccessibleButton_kind_primary:hover {
    background: var(--tg-accent-light) !important;
    transform: translateY(-1px) !important;
}

.mx_AccessibleButton_kind_secondary,
.mx_Dialog_secondary {
    background: transparent !important;
    border: 1.5px solid var(--tg-accent) !important;
    color: var(--tg-accent) !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
    padding: 10px 22px !important;
    transition: all 0.15s ease !important;
}

.mx_AccessibleButton_kind_secondary:hover {
    background: rgba(82,136,193,0.12) !important;
}

.mx_AccessibleButton_kind_danger {
    background: #c0392b !important;
    color: #fff !important;
    border-radius: 10px !important;
    font-weight: 600 !important;
    border: none !important;
    padding: 10px 22px !important;
}

/* ── TOGGLE SWITCHES (Telegram Blue) ────────────────────────────────────── */
.mx_ToggleSwitch.mx_ToggleSwitch_on {
    background: var(--tg-accent) !important;
    border-color: var(--tg-accent) !important;
}

/* ── AUTH / LOGIN SCREEN ────────────────────────────────────────────────── */
.mx_AuthPage {
    background: radial-gradient(ellipse at center, #17212b 0%, #0e1621 70%) !important;
}

.mx_AuthPage_modal, .mx_Welcome {
    background: transparent !important;
}

.mx_AuthBody, .mx_Login, .mx_Register {
    background: #17212b !important;
    border: 1px solid #242f3d !important;
    border-radius: 18px !important;
    box-shadow: 0 24px 72px rgba(0,0,0,0.65) !important;
    padding: 32px 36px !important;
    width: 420px !important;
    max-width: 100% !important;
}

.mx_AuthBody h1, .mx_AuthBody h2,
.mx_Login h2, .mx_Register h2 {
    color: #fff !important;
    font-size: 22px !important;
    font-weight: 700 !important;
    text-align: center !important;
    margin-bottom: 8px !important;
}

.mx_AuthBody p { color: var(--tg-text2) !important; text-align: center !important; }

.mx_AuthBody .mx_Field { margin: 14px 0 !important; }
.mx_AuthBody .mx_Field input {
    background: #0e1621 !important;
    border: 1.5px solid #242f3d !important;
    border-radius: 12px !important;
    color: #fff !important;
    padding: 12px 16px !important;
    font-size: 15px !important;
}
.mx_AuthBody .mx_Field input:focus { border-color: var(--tg-accent) !important; }
.mx_AuthBody .mx_Field label { color: var(--tg-text2) !important; font-size: 13px !important; }

.mx_Login_submit,
.mx_AuthBody .mx_AccessibleButton_kind_primary {
    width: 100% !important;
    background: var(--tg-accent) !important;
    border-radius: 12px !important;
    color: #fff !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    padding: 13px !important;
    box-shadow: 0 4px 16px rgba(82,136,193,0.4) !important;
    margin-top: 8px !important;
}

.mx_Login_submit:hover,
.mx_AuthBody .mx_AccessibleButton_kind_primary:hover {
    background: var(--tg-accent-light) !important;
    box-shadow: 0 6px 20px rgba(64,167,227,0.5) !important;
}

.mx_AuthBody a, .mx_AuthBody .mx_AccessibleButton_kind_link {
    color: var(--tg-accent-light) !important;
    font-size: 14px !important;
}

/* ── TOOLTIP ────────────────────────────────────────────────────────────── */
.mx_Tooltip, [class*="Tooltip"] {
    background: #1c2733 !important;
    color: #fff !important;
    border-radius: 8px !important;
    border: 1px solid #2a3645 !important;
    font-size: 13px !important;
    padding: 6px 10px !important;
    box-shadow: 0 4px 16px rgba(0,0,0,.4) !important;
}

/* ── SCROLLBAR ──────────────────────────────────────────────────────────── */
* { scrollbar-width: thin; scrollbar-color: #2a3645 transparent; }
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #2a3645; border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #3b4a5a; }
