# =============================================================================
# Sovereign Messenger — Environment Secrets EXAMPLE
# =============================================================================
# Copy this file to .env and fill in real values.
# .env is gitignored. THIS FILE is committed (no real secrets here).
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password for the 'synapse_user' Postgres account.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_min32chars

# ── Synapse ───────────────────────────────────────────────────────────────────
# Shared secret for register_new_matrix_user CLI (account provisioning).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
REGISTRATION_SHARED_SECRET=CHANGE_ME_min32chars

# ── Synapse Admin API (used by provisioning scripts) ──────────────────────────
# Admin Matrix User ID (set after first account creation).
SYNAPSE_ADMIN_USER=@admin:gov.local

# Admin access token (obtain after first login via the Matrix API).
# See backend/scripts/README.md for how to obtain this token.
SYNAPSE_ADMIN_TOKEN=

# ── Synapse-Admin UI container ────────────────────────────────────────────────
# Public homeserver URL that the synapse-admin UI connects to.
SYNAPSE_BASE_URL=https://gov.local
